#include <bits/stdc++.h> //Swap the positions of pairs (left->right || right->left) same
using namespace std;

#define FAST ios::sync_with_stdio(false); cin.tie(0); cout.tie(0);

int swapAdjacentBits(int n) {
    return ((n & 0xAAAAAAAA) >> 1) | ((n & 0x55555555) << 1);
}

int main() {
    FAST
    int T;
    cin >> T;
    while (T--) {
        int n;
        cin >> n;
        cout << swapAdjacentBits(n) << "\n";
    }
    return 0;
}
